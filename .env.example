# ==============================================================================
# CREST GROUP PRODUCTION SECURITY ENVIRONMENT TEMPLATE
# Copy to your Secret Manager / KMS / systemd EnvironmentFile (chmod 600).
# NEVER commit real secrets to Git.
# ==============================================================================

# 256-bit hex master key (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CREST_MASTER_KEY=

# Set to 'production' in live deployments (enforces Secure flag on HttpOnly cookies)
NODE_ENV=production

# Bind strictly to loopback when behind Nginx/Cloudflare (or 0.0.0.0 only with direct TLS)
HOST=127.0.0.1
PORT=4000

# Set to 'true' to let Node serve built dist/ on a single origin with HTTP security headers
SERVE_STATIC=true

# Set to 'true' ONLY when running behind a trusted TLS reverse proxy (Nginx / Cloudflare)
TRUST_PROXY=true

# Comma-separated allowlist of valid Host / Origin headers (blocks Host header injection)
ALLOWED_HOSTS=crestgroup.co.tz,www.crestgroup.co.tz

# Optional: Native Node.js TLS 1.3 mode (if not terminating TLS at Nginx/Cloudflare)
# TLS_CERT_PATH=/etc/letsencrypt/live/crestgroup.co.tz/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/crestgroup.co.tz/privkey.pem
